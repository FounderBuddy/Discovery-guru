// GitHub Codespaces / VS Code dev container: the app plus a Postgres 16 database, ready to run.
// After the codespace is created:   make dev     then open the forwarded port 8000.
{
  "name": "Discovery Guru",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "remoteEnv": {
    "LEDGER_DB_URL": "postgresql+psycopg://sdp:sdp-local@localhost:5432/ledger"
  },
  "postCreateCommand": "make install web",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Discovery Guru", "onAutoForward": "notify" },
    "5432": { "label": "Postgres (ledger)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "dbaeumer.vscode-eslint"]
    }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" }
}
